#!/usr/bin/env bash
set -euo pipefail

# Pull the k3s kubeconfig from the cluster server host and point it at the
# tailnet endpoint, so `ax` and kubectl work from any host on the tailnet.
# Run once per client host, and again if k3s rotates its client certs.

server_host="${1:-nixos}"
dest="${2:-$HOME/.kube/config}"

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

ssh "$server_host" cat /home/jay/.kube/config > "$tmp"
sed -i 's|https://127.0.0.1:6443|https://nixos.tail69fe1.ts.net:6443|' "$tmp"

mkdir -p "$(dirname "$dest")"
install -D -m 600 "$tmp" "$dest"
echo "wrote $dest (server: nixos.tail69fe1.ts.net:6443)"
