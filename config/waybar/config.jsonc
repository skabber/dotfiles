// ──────────────────────────────────────────────
// Waybar — Catppuccin Mocha
// Bar for Hyprland · matches ~/.config/waybar/style.css
// ──────────────────────────────────────────────
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 2,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/screens",
        "power-profiles-daemon",
        "group/hardware",
        "network",
        "custom/tailscale",
        "bluetooth",
        "pulseaudio",
        "tray"
    ],

    "custom/launcher": {
        "format": "󱄅",
        "tooltip-format": "Apps  |  Super+R",
        "on-click": "rofi -show drun",
        "on-click-middle": "rofi -show window"
    },

    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰧞",
        "window-rewrite": {
            "class<.*[Ff]irefox.*>": "󰈹",
            "class<.*[Gg]hostty.*>": "󰊠",
            "class<.*[Cc]hrome.*>": "󰊯",
            "class<.*[Cc]hromium.*>": "󰊯",
            "class<.*[Nn]autilus.*>": "󰝗",
            "class<code.*>": "󰨞",
            "class<.*[Ss]team.*>": "󰓓",
            "class<.*[Dd]iscord.*>": "󰙯",
            "class<.*[Ss]lack.*>": "󰒋",
            "class<.*[Ss]potify.*>": "󰓇",
            "class<.*[Oo]bsidian.*>": "󰠮",
            "class<1[Pp]assword.*>": "󰢁",
            "class<.*[Pp]avucontrol.*>": "󰕿"
        },
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 },
        "disable-scroll": false
    },

    "hyprland/window": {
        "max-length": 42,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - Ghostty": "󰊠  $1",
            "(.*) — Chromium|(.*) - Google Chrome": "󰊯  $1"
        }
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%a, %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "months":     "<span color='#cba6f7'><b>{}</b></span>",
                "days":       "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks":      "<span color='#585b70'><b>{}</b></span>",
                "weekdays":   "<span color='#89b4fa'><b>{}</b></span>",
                "today":      "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "format": "󰻠  {usage}%",
        "interval": 3,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "interval": 5,
        "tooltip": false
    },

    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂁", "󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo} ({power}W)",
        "interval": 30
    },

    "power-profiles-daemon": {
        "format": "{icon}  {profile}",
        "tooltip-format": "Power profile: {profile} ({driver})\nClick to cycle · Super+Shift+B",
        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾔",
            "power-saver": "󰾐"
        }
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  Wired",
        "format-linked": "󰤪  {essid}",
        "format-disconnected": "󰤭  Offline",
        "tooltip-format-wifi": "󰤨  <b>{essid}</b>  <small><span color='#a6adc8'>{signalStrength}% · {signaldBm} dBm</span></small>\n<span color='#89b4fa'>󰛳</span>  {ipaddr} via {gwaddr}",
        "tooltip-format-ethernet": "󰈀  <b>Wired</b>  <small><span color='#a6adc8'>{ifname}</span></small>\n<span color='#89b4fa'>󰛳</span>  {ipaddr} via {gwaddr}",
        "tooltip-format-disconnected": "󰤭  Not connected",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "nm-connection-editor",
        "max-length": 22,
        "interval": 10
    },

    "group/hardware": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": ["battery", "cpu", "memory"]
    },

    "custom/screens": {
        "exec": "~/.config/waybar/scripts/screens.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/screens.sh cycle",
        "on-click-right": "~/.config/waybar/scripts/screens.sh menu",
        "tooltip": true
    },

    "custom/tailscale": {
        "exec": "~/.config/waybar/scripts/tailscale-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/tailscale-status.sh toggle",
        "on-click-right": "xdg-open https://login.tailscale.com/admin/machines",
        "tooltip": true
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias} · off",
        "tooltip-format-connected": "{controller_alias} · {num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "~/.config/waybar/scripts/bluetooth-picker.sh",
        "on-click-right": "~/.config/waybar/scripts/bluetooth-picker.sh power"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰸈  Muted",
        "format-bluetooth": "{icon}󰂯  {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰥰",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏳",
            "car": "󰄍",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "~/.config/waybar/scripts/audio-picker.sh sink",
        "on-click-middle": "~/.config/waybar/scripts/audio-picker.sh source",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
